  "params": {
    "w": "Eye width as a multiple of geometry.eye.width.",
    "h": "Eye height as a multiple of geometry.eye.height.",
    "lid": "Top-lid drop, 0 (open) to 1 (closed), as a fraction of eye height.",
    "angle": "Lid angle in degrees. Positive tilts the inner corner down (annoyed). Negative tilts the outer corner down (sad).",
    "smile": "Bottom cutout depth, 0 to 1, as a fraction of eye height. Around 0.5 gives ^ ^ eyes.",
    "lookX": "Gaze offset, -1 to 1, scaled by geometry.look.maxX.",
    "lookY": "Gaze offset, -1 to 1, scaled by geometry.look.maxY. Positive looks down.",
    "blush": "Cheek blush opacity, 0 to 1."
